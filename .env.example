# SMTP Configuration for Contact Form
# Copy this file to .env.local and fill in your actual values

# Gmail SMTP Settings (or your email provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Where to receive contact form emails
CONTACT_RECEIVER=punitj668@gmail.com

# Punit AI chat (server-side only, set in Vercel > Settings > Environment Variables)
# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override
AI_MODEL=
